{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__clerk/:match*",
      "destination": "/api/clerk-proxy?__clerk_path=:match*"
    },
    {
      "source": "/__clerk",
      "destination": "/api/clerk-proxy"
    },
    {
      "source": "/((?!api/|__clerk).*)",
      "destination": "/index.html"
    }
  ]
}
